{
  "formatVersion": 5,
  "flow": "task_plan_writing",
  "description": "The routing of ${CLAUDE_PLUGIN_ROOT}/instructions/task_plan_writing_instructions_core.md in format 5, declaring its own vocabulary: the task-plan loop, whose gates are dispatched together as one set every round and whose round node joins them, the UI-test-plan loop and convergence, with the values the walker resolves (counters, path templates, heartbeats, findings folders, skip predicates, cap summaries). The dispatch blocks each agent receives are not here; they stay in that core. Each dispatch node's promptSource names the core heading its dispatch blocks are cut from, and the graph's hooks are the host's commit and ledger points. This is the graph flow-walker.sh hands devscene-flow-walker to walk, and the one the planning driver's libraries read for its node list.",
  "vocabulary": {
    "outcomes": {
      "returned": {},
      "questions": {},
      "no_ui": {},
      "PASS": { "verdict": "pass" },
      "FAIL": { "verdict": "fail" },
      "error": { "held": true },
      "blocker": { "held": true }
    },
    "bindings": {
      "<ask>": { "primitive": "interrupt", "resumeOutcome": "answered" },
      "<escalate>": { "primitive": "stop", "reasons": ["cap", "error", "blocker"] },
      "<terminal_handoff>": { "primitive": "end" }
    },
    "predicates": {
      "phase_parity_off": { "records": "skipped", "inRoundCounts": false },
      "phase_qa_off": { "records": "skipped", "inRoundCounts": false },
      "run_mode_skips_parity": { "records": "passed-by-exclusion", "inRoundCounts": true },
      "run_mode_skips_architecture": { "records": "passed-by-exclusion", "inRoundCounts": true },
      "run_mode_skips_qa": { "records": "passed-by-exclusion", "inRoundCounts": true }
    },
    "hooks": {
      "commit_plan_round": {},
      "flip_ledger": {},
      "commit_convergence": {}
    }
  },
  "start": "plan_writer",
  "entries": ["plan_writer", "plan_round", "ui_writer", "ui_review", "convergence"],
  "counters": {
    "iteration": { "cap": 5 }
  },
  "paths": {
    "story_index": "{state_dir}/story_plans/{branch}_story_plan.md",
    "task_files": "{state_dir}/task_plans/{branch}/",
    "revision_note": "{state_dir}/plan_revisions/{branch}/task_plan_revision_{round}.md",
    "ui_test_index": "{state_dir}/ui_test_plans/{branch}_ui_test_plan.md"
  },
  "reports": ["business_parity_review", "architecture_review", "plan_review", "ui_test"],
  "nodes": {
    "plan_writer": {
      "kind": "dispatch",
      "agent": "task-plan-writer",
      "heartbeat": "[plan-write · iter {iteration}] → task-plan-writer",
      "prompts": ["initial", "revision"],
      "promptSource": "instructions/task_plan_writing_instructions_core.md → ## Loop → ### 1. Spawn `task-plan-writer`",
      "outcomes": {
        "returned": { "to": "plan_round" },
        "questions": { "binding": "<ask>", "resume": "plan_writer" },
        "error": { "binding": "<escalate>", "reason": "error" },
        "blocker": { "binding": "<escalate>", "reason": "blocker" }
      }
    },
    "business_parity_review": {
      "kind": "dispatch",
      "agent": "business-parity-reviewer",
      "heartbeat": "[plan-write · parity · iter {iteration}] → business-parity-reviewer",
      "promptSource": "instructions/task_plan_writing_instructions_core.md → ## Loop → ### 2. Business-parity review (plan-review mode)",
      "findingsFolder": "{state_dir}/business_parity_reviews/{branch}/",
      "skip": [
        {
          "when": "run_mode_skips_parity",
          "to": "plan_round",
          "report": { "business_parity_review": "passed-by-exclusion" }
        },
        {
          "when": "phase_parity_off",
          "to": "plan_round",
          "report": { "business_parity_review": "skipped" }
        }
      ],
      "outcomes": {
        "PASS": {
          "to": "plan_round",
          "report": { "business_parity_review": "passed" }
        },
        "FAIL": { "to": "plan_round" },
        "error": { "binding": "<escalate>", "reason": "error" },
        "blocker": { "binding": "<escalate>", "reason": "blocker" }
      }
    },
    "architecture_review": {
      "kind": "dispatch",
      "agent": "architecture-reviewer",
      "heartbeat": "[plan-write · arch · iter {iteration}] → architecture-reviewer",
      "promptSource": "instructions/task_plan_writing_instructions_core.md → ## Loop → ### 3. Architecture review (plan-review mode)",
      "findingsFolder": "{state_dir}/architecture_reviews/{branch}/",
      "skip": [
        {
          "when": "run_mode_skips_architecture",
          "to": "plan_round",
          "report": { "architecture_review": "passed-by-exclusion" }
        }
      ],
      "outcomes": {
        "PASS": {
          "to": "plan_round",
          "report": { "architecture_review": "passed" }
        },
        "FAIL": { "to": "plan_round" },
        "error": { "binding": "<escalate>", "reason": "error" },
        "blocker": { "binding": "<escalate>", "reason": "blocker" }
      }
    },
    "plan_review": {
      "kind": "dispatch",
      "agent": "task-plan-reviewer",
      "heartbeat": "[plan-write · iter {iteration}] → task-plan-reviewer",
      "promptSource": "instructions/task_plan_writing_instructions_core.md → ## Loop → ### 4. Spawn `task-plan-reviewer`",
      "findingsFolder": "{state_dir}/task_plan_reviews/{branch}/",
      "outcomes": {
        "PASS": {
          "to": "plan_round",
          "report": { "plan_review": "passed" }
        },
        "FAIL": { "to": "plan_round" },
        "error": { "binding": "<escalate>", "reason": "error" },
        "blocker": { "binding": "<escalate>", "reason": "blocker" }
      }
    },
    "plan_round": {
      "kind": "round",
      "parallel": true,
      "gates": ["business_parity_review", "architecture_review", "plan_review"],
      "writer": "plan_writer",
      "counter": "iteration",
      "convergingFrom": 2,
      "plan": ["story_index", "task_files"],
      "revisionNote": "revision_note",
      "after": ["commit_plan_round", "flip_ledger"],
      "outcomes": {
        "PASS": { "to": "ui_writer", "reset": "iteration", "ledger": "P1" },
        "FAIL": {
          "to": "plan_writer",
          "increment": "iteration",
          "prompt": "revision",
          "onCap": {
            "binding": "<escalate>",
            "reason": "cap",
            "summary": "the plan loop reached its {cap}-revision cap; the gates open when it fired: {open_gates}",
            "roundCounts": ["business_parity_review", "architecture_review", "plan_review"],
            "evidence": "story_index"
          }
        }
      }
    },
    "ui_writer": {
      "kind": "dispatch",
      "agent": "ui-tests-plan-writer",
      "heartbeat": "[ui-test-write · iter {iteration}] → ui-tests-plan-writer",
      "prompts": ["initial", "revision"],
      "promptSource": "instructions/task_plan_writing_instructions_core.md → ## UI-test-plan write loop → ### 1. Spawn `ui-tests-plan-writer`",
      "skip": [
        {
          "when": "phase_qa_off",
          "to": "convergence",
          "report": { "ui_test": "qa-phase-off" }
        },
        {
          "when": "run_mode_skips_qa",
          "to": "convergence",
          "report": { "ui_test": "run-mode-skipped" }
        }
      ],
      "outcomes": {
        "returned": { "to": "ui_review" },
        "no_ui": {
          "to": "convergence",
          "ledger": "P2",
          "report": { "ui_test": "no_ui" }
        },
        "questions": { "binding": "<ask>", "resume": "ui_writer" },
        "error": { "binding": "<escalate>", "reason": "error" },
        "blocker": { "binding": "<escalate>", "reason": "blocker" }
      }
    },
    "ui_review": {
      "kind": "dispatch",
      "agent": "ui-tests-plan-reviewer",
      "heartbeat": "[ui-test-write · iter {iteration}] → ui-tests-plan-reviewer",
      "promptSource": "instructions/task_plan_writing_instructions_core.md → ## UI-test-plan write loop → ### 2. Spawn `ui-tests-plan-reviewer`",
      "findingsFolder": "{state_dir}/ui_test_plan_reviews/{branch}/",
      "outcomes": {
        "PASS": {
          "to": "convergence",
          "ledger": "P2",
          "report": { "ui_test": "passed" }
        },
        "FAIL": {
          "to": "ui_writer",
          "increment": "iteration",
          "prompt": "revision",
          "onCap": {
            "binding": "<escalate>",
            "reason": "cap",
            "summary": "{cap} UI-test-plan-review iterations did not converge",
            "evidence": "ui_test_index"
          }
        },
        "error": { "binding": "<escalate>", "reason": "error" },
        "blocker": { "binding": "<escalate>", "reason": "blocker" }
      }
    },
    "convergence": {
      "kind": "terminal",
      "binding": "<terminal_handoff>",
      "before": ["flip_ledger", "commit_convergence"]
    }
  }
}
