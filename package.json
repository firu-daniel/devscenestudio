{
  "name": "devscene-studio",
  "productName": "DevScene Studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Desktop app for DevScene runs",
  "license": "Apache-2.0",
  "author": "Firu Daniel",
  "main": "dist/main/main.cjs",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev:browser": "vite --mode browser",
    "build": "vite build && node scripts/build-main.mjs",
    "build:browser": "vite build --mode browser",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "check": "tsc -b && eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=browser",
    "test:electron": "playwright test --project=electron",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "start": "npm run build && electron .",
    "dist:mac": "node scripts/require-signing-env.mjs && npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@headlessui/react": "2.2.10",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-virtual": "3.14.28",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dompurify": "3.5.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "jsdom": "31.0.1",
    "lucide-react": "1.81.0",
    "markdown-it": "15.0.3",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "tailwindcss": "4.3.5",
    "typebox": "1.4.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "zustand": "5.1.0"
  },
  "homepage": "https://github.com/firu-daniel/devscenestudio"
}
