// LAYER renderer: React, DOM, built by Vite. No Node types.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "../../.tsbuild/renderer.tsbuildinfo",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom/vitest"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "references": [{ "path": "../shared" }]
}
